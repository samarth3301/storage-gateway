# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9876

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cdn_storage

# Authentication
REGISTRATION_TOKEN=change-me-openssl-rand-hex-32
# 32-byte key that encrypts stored bucket credentials: openssl rand -base64 32
CREDENTIALS_KEY=

# Cache configuration
CACHE_MAX_MB=512
CACHE_MAX_OBJECT_MB=32
CACHE_TTL_SECONDS=3600
CACHE_NOT_FOUND_TTL_SECONDS=60

# Logging
RUST_LOG=s3_cdn_network=info
LOG_FORMAT=json
